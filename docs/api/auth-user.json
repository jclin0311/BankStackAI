{
  "openapi": "3.0.1",
  "info": {
    "title": "auth-user",
    "description": "BankStackAI \u2014 auth-user",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8094",
      "description": "Local \u2014 kubectl -n bankstack port-forward svc/auth-user 8094:8094"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/iam/users": {
      "post": {
        "tags": [
          "create-user-controller"
        ],
        "operationId": "createUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/test/secure": {
      "get": {
        "tags": [
          "test-controller"
        ],
        "operationId": "secure",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/test/public": {
      "get": {
        "tags": [
          "test-controller"
        ],
        "operationId": "pub",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Auth0 access token. Paste the raw JWT \u2014 Swagger adds the \"Bearer \" prefix.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}